# claude-code-multiterminal-kit configuration.
#
# Copy to ~/.config/claude-multiterminal/env (override the location with
# MULTITERMINAL_ENV). The skills, the hook and the drift report all read that
# one file; real environment variables win over it. Never commit the real file.
# Keep it valid shell: the skills `source` it, so quote values containing spaces.

# --- repo layout (used by /new-effort, /land, /state, drift-check) ---------
# The main checkout. It stays on DEFAULT_BRANCH and clean; nobody edits there.
MAIN_WORKTREE=/path/to/your/repo
# Where effort worktrees live: $WORKTREE_ROOT/<effort>
WORKTREE_ROOT=/path/to/your/wt
DEFAULT_BRANCH=main
BRANCH_PREFIX=feat
# Space-separated paths (relative to the repo root) that are gitignored but
# needed to run the project. /new-effort symlinks them into each new worktree.
LINK_PATHS='.env node_modules'

# --- shared memory (used by /checkpoint, /state, drift-check) --------------
# The directory every terminal reads and writes its verified notes in.
MEMORY_DIR=/path/to/shared/memory
STATE_FILE=project-state.md
DRIFT_REPORT_FILE=drift-report.md

# --- checkpoint hook --------------------------------------------------------
# A Bash command matching this regex triggers the "run /checkpoint now" nudge.
CHECKPOINT_TRIGGER_REGEX='gh pr merge|deploy\.sh'

# --- deploy target (used by /deploy-prod, /state, drift-check) --------------
# Leave PROD_SSH empty to skip every remote check.
PROD_SSH=deploy@prod.example.com
PROD_CHECKOUT=/srv/app
PROD_DEPLOY_CMD='cd /srv/app && ./deploy.sh'
HEALTH_URL=https://app.example.com/health
# Optional staging stack, deployed first.
STAGING_DEPLOY_CMD='cd /srv/app-staging && ./deploy-staging.sh main'
STAGING_HEALTH_URL=https://staging.example.com/health
# Free text the deploy skill reads out as the "when not to deploy" rule.
DEPLOY_BLACKOUT='weekdays 11:00-14:00 and 18:00-21:00 local time'

# --- drift report -----------------------------------------------------------
STALE_PR_DAYS=2

# --- effect checker ---------------------------------------------------------
# Path to your effects config (copy verify-effects/effects.config.example.json).
EFFECTS_CONFIG=/path/to/effects.config.json

# --- md-gdocs-sync (see md-gdocs-sync/SETUP.md) ----------------------------
# Folder for the OAuth client and token. Outside any repo.
MD_GDOCS_SYNC_DIR=~/.config/md-gdocs-sync
# Map file; defaults to ./doc-sync-map.json in the repo being committed.
DOC_SYNC_MAP=
# Local port for the one-time consent redirect.
OAUTH_PORT=4100
